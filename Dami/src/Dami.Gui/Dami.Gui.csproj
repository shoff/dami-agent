<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated XAML code-behind partials are not ours to document. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The icon set: dami.svg is the drawing, the PNGs are its rendered forms
         (tools/install-gui.sh copies them into hicolor; dami.png is the window icon). -->
    <AvaloniaResource Include="Assets/dami.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Dami.Authentication/Dami.Authentication.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The reason this client is .NET: the runtime's own contracts, not a
         hand-mirrored copy of them in another language. -->
    <ProjectReference Include="../Dami.Contracts/Dami.Contracts.csproj" />
  </ItemGroup>
</Project>
