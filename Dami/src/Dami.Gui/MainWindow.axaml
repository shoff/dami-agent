<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dami.Gui"
        xmlns:contracts="clr-namespace:Dami.Contracts.TaskBoard;assembly=Dami.Contracts"
        x:Class="Dami.Gui.MainWindow"
        x:DataType="local:WindowState"
        Title="Dami" Width="1440" Height="940" MinWidth="1100" MinHeight="680"
        Icon="/Assets/dami.png"
        Background="#141414">

  <Window.Resources>
    <SolidColorBrush x:Key="Ink">#EEEEEE</SolidColorBrush>
    <SolidColorBrush x:Key="Dim">#AAAAAA</SolidColorBrush>
    <SolidColorBrush x:Key="Panel">#1C1C1C</SolidColorBrush>
    <SolidColorBrush x:Key="Accent">#ABA5FF</SolidColorBrush>
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="WorkspaceStyles.axaml"/>
  </Window.Styles>

  <Panel>
  <DockPanel x:Name="WorkspaceBody">
  <Menu DockPanel.Dock="Top" Background="#1C1C1C" Foreground="{StaticResource Ink}">
    <MenuItem Header="_File">
      <MenuItem x:Name="ExitMenuItem" Header="E_xit"/>
    </MenuItem>
    <MenuItem Header="_Tasks">
      <MenuItem x:Name="JobsMenuItem" Header="_Jobs…"/>
    </MenuItem>
    <MenuItem Header="_About">
      <MenuItem x:Name="AboutMenuItem" Header="About Dami"/>
    </MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" Padding="24,18" BorderBrush="#303030" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="180,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Border Width="38" Height="38" CornerRadius="12" Background="#343047">
          <TextBlock Text="✦" FontSize="26" Foreground="{StaticResource Accent}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Dami" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{StaticResource Ink}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
        <TextBlock Text="YOUR WORKSPACE" FontSize="10" LetterSpacing="2" Foreground="{StaticResource Accent}"/>
        <TextBlock Text="Room to think. Space to make." FontSize="14" Foreground="{StaticResource Dim}"/>
      </StackPanel>
      <Button x:Name="CommandMenuButton" Grid.Column="2" Classes="quiet" VerticalAlignment="Center"
              ToolTip.Tip="Find a page or action (Ctrl+K)">
        <Grid ColumnDefinitions="*,Auto" Width="200">
          <TextBlock Text="Find a page or action"/>
          <TextBlock Grid.Column="1" Text="Ctrl K" FontSize="11" Margin="16,0,0,0"
                     Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
        </Grid>
      </Button>
    </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Padding="22,10" Background="#161616"
          BorderBrush="#303030" BorderThickness="0,1,0,0">
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
      <TextBlock Text="{Binding SystemStatus.Label}" FontSize="10" FontWeight="SemiBold"
                 Foreground="{StaticResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding SystemStatus.Message}" FontSize="12"
                 Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding SystemStatus.Message}"/>
      <TextBlock x:Name="StatusLine" Grid.Column="2" Margin="20,0,0,0" FontSize="11" MaxWidth="350" TextTrimming="CharacterEllipsis"
                 Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
      <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="2" Margin="0,6,0,0"
                   IsIndeterminate="True" IsVisible="{Binding SystemStatus.IsBusy}"/>
    </Grid>
  </Border>
  <Panel>
  <!-- Right-click anything to ask about it. The popup is a child of the window rather
       than of whatever was clicked, because the thing under the pointer is often inside a
       virtualising list that will recycle the container out from under it mid-question. -->
  <TabControl x:Name="WorkspaceTabs" TabStripPlacement="Left" Margin="12,16,12,12">
    <TabItem Classes="workspace" ToolTip.Tip="Conversation (Ctrl+1)">
      <TabItem.Header>
        <Grid ColumnDefinitions="24,*">
          <TextBlock Text="01" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Conversation" FontSize="13" VerticalAlignment="Center"/>
        </Grid>
      </TabItem.Header>
  <Grid x:Name="ConversationLayout" ColumnDefinitions="*,330" RowDefinitions="Auto,*" Margin="16,0,4,4">

    <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="2,4,0,20">
      <StackPanel Spacing="5">
        <TextBlock Text="Conversation" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
        <TextBlock Text="Follow an idea. Work something out. Make it happen."
                   FontSize="12" Foreground="{StaticResource Dim}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="FindConversation" Content="Find" Classes="quiet" ToolTip.Tip="Find a message in this conversation (Ctrl+F)"/>
        <ToggleButton x:Name="FocusToggle" Content="Focus mode" Classes="quiet"
                      ToolTip.Tip="Give the conversation the full width; toggle again to show attention."/>
      </StackPanel>
    </Grid>

    <!-- Conversation -->
    <Border x:Name="ConversationPanel" Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}"
            CornerRadius="16" Padding="20" Margin="0,0,12,0">
      <DockPanel>
        <Border x:Name="ConversationFindBar" DockPanel.Dock="Top" IsVisible="False" Margin="0,0,0,14"
                Padding="8" Background="#292929" CornerRadius="9">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <TextBox x:Name="ConversationFindInput" PlaceholderText="Find in this conversation…" MinWidth="150"
                     Background="Transparent" BorderThickness="0" FontSize="13"
                     ToolTip.Tip="Search messages shown in this window. Enter: next; Shift+Enter: previous."/>
            <TextBlock x:Name="ConversationFindCount" Grid.Column="1" FontSize="11" Margin="10,0"
                       VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
            <Button x:Name="ConversationFindPrevious" Grid.Column="2" Content="↑" Classes="quiet" Padding="10,5"
                    ToolTip.Tip="Previous matching message (Shift+Enter)"/>
            <Button x:Name="ConversationFindNext" Grid.Column="3" Content="↓" Classes="quiet" Padding="10,5" Margin="4,0"
                    ToolTip.Tip="Next matching message (Enter)"/>
            <Button x:Name="ConversationFindClose" Grid.Column="4" Content="✕" Classes="quiet" Padding="10,5"
                    ToolTip.Tip="Close find (Esc)"/>
          </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" Padding="12"
                Classes="composer" Background="#161616" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="12">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto">
            <ScrollViewer MaxHeight="168" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding PendingImages}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:PendingChatImage">
                    <Border Width="204" Margin="0,0,8,8" Padding="5" CornerRadius="9" Background="#292929">
                      <Grid ColumnDefinitions="56,*,Auto" RowDefinitions="Auto,*">
                        <Button Grid.RowSpan="2" Tag="image-preview" Classes="image-preview" ToolTip.Tip="{Binding FileName}"
                                AutomationProperties.Name="Open attached image">
                          <Image Source="{Binding Thumbnail}" Width="56" Height="56" Stretch="UniformToFill"/>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Margin="8,6,2,0" Foreground="{StaticResource Ink}" ToolTip.Tip="{Binding FileName}"/>
                        <Button Grid.Column="2" Tag="image-remove" Content="×" Classes="quiet" Padding="6,1"
                                ToolTip.Tip="Remove this attachment" AutomationProperties.Name="Remove attachment"/>
                        <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Text="Ready to send" FontSize="10"
                                   Margin="8,0,0,4" VerticalAlignment="Bottom" Foreground="{StaticResource Dim}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
              <TextBox x:Name="Input" Grid.Row="1" Classes="chat-input"
                       MinWidth="220" MinHeight="64" MaxHeight="160" AcceptsReturn="True" TextWrapping="Wrap"
                       PlaceholderText="Tell me what you're thinking…" FontSize="15"
                       Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0"
                       ToolTip.Tip="You can also drop an image here or paste one from the clipboard."/>
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="2,8,0,0">
              <Button x:Name="AttachImages" Content="+ Attach" Classes="quiet" Padding="12,7" FontSize="12"
                      ToolTip.Tip="Choose images to attach. You can also paste or drop them here."/>
              <ToggleButton x:Name="SpeakToggle" Grid.Column="2" Content="Read aloud" Classes="quiet"
                            Padding="10,7" FontSize="11" Margin="10,0,8,0"
                            ToolTip.Tip="Read replies in Dami's voice. Off until you enable it."/>
              <Button x:Name="SendButton" Grid.Column="3" Content="send" Classes="primary" MinWidth="72"
                      ToolTip.Tip="Send your message (Enter)"/>
            </Grid>
            <TextBlock Grid.Row="3" Text="Enter to send · Shift+Enter for a new line" FontSize="10" Margin="4,10,0,0"
                       Foreground="{StaticResource Dim}"/>
          </Grid>
        </Border>
        <Grid>
        <ScrollViewer x:Name="ChatScroll" Focusable="True">
          <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:Message">
                <Border Classes="message" Classes.you="{Binding IsYou}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Who}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="Copy" Tag="copy" Classes="quiet" Padding="8,3"
                              FontSize="10" IsVisible="{Binding CanCopy}" ToolTip.Tip="Copy this message"/>
                    </Grid>
                    <SelectableTextBlock Text="{Binding Body}" IsVisible="{Binding IsYou}" TextWrapping="Wrap" FontSize="15"
                                         LineHeight="24" Foreground="{StaticResource Ink}"/>
                    <local:ReplyView IsVisible="{Binding !IsYou}"/>
                    <ItemsControl ItemsSource="{Binding Attachments}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:PendingChatImage">
                          <Button Tag="image-preview" Classes="image-preview" Margin="0,0,8,4" ToolTip.Tip="{Binding FileName}"
                                  AutomationProperties.Name="Open attached image">
                            <StackPanel Width="104" Spacing="5">
                              <Image Source="{Binding Thumbnail}" Height="80" Stretch="UniformToFill"/>
                              <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="10" Margin="6,0,6,5"/>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Tag="reply-image" Classes="image-preview" HorizontalAlignment="Left"
                            IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Open image · zoom and pan" AutomationProperties.Name="Open reply image">
                      <Image Source="{Binding Image}" MaxWidth="640" MaxHeight="480" Stretch="Uniform"/>
                    </Button>
                    <TextBlock Text="{Binding Meta}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource Dim}"/>
                    <Button Content="Restore message" Tag="recover" IsVisible="{Binding CanRecover}"
                            HorizontalAlignment="Left" Classes="quiet" Padding="10,5" FontSize="11"
                            ToolTip.Tip="Put the original text and images back in the composer for editing."/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding Messages.Count, Converter={x:Static local:IsEmpty.instance}}">
        <StackPanel VerticalAlignment="Center" Spacing="12" Margin="12,24" MaxWidth="620">
          <Border Width="54" Height="54" CornerRadius="18" Background="#343047" HorizontalAlignment="Left">
            <TextBlock Text="✦" FontSize="32" Foreground="{StaticResource Accent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="What's on your mind?" FontSize="30" FontWeight="SemiBold"
                     TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,8,0,0"/>
          <TextBlock Text="A question, a plan, a spark of an idea. Start anywhere."
                     FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource Dim}"/>
          <UniformGrid Columns="2" Margin="-5,14,-5,0">
            <Button Classes="starter" Tag="starter" CommandParameter="Help me think through an idea. Ask me a question to get started.">
              <StackPanel Spacing="6">
                <TextBlock Text="Explore an idea" FontWeight="SemiBold"/>
                <TextBlock Text="Find a fresh angle together" Classes="card-note"/>
              </StackPanel>
            </Button>
            <Button Classes="starter" Tag="starter" CommandParameter="Help me turn a goal into a practical plan. Ask me what I want to achieve.">
              <StackPanel Spacing="6">
                <TextBlock Text="Make a plan" FontWeight="SemiBold"/>
                <TextBlock Text="Turn a goal into next steps" Classes="card-note"/>
              </StackPanel>
            </Button>
            <Button Classes="starter" Tag="starter" CommandParameter="Help me write something clearly. Ask me about the audience and what I want to say.">
              <StackPanel Spacing="6">
                <TextBlock Text="Find the words" FontWeight="SemiBold"/>
                <TextBlock Text="Write, rethink, or polish" Classes="card-note"/>
              </StackPanel>
            </Button>
            <Button Classes="starter" Tag="starter" CommandParameter="Create an image of a quiet forest observatory under a sky full of stars.">
              <StackPanel Spacing="6">
                <TextBlock Text="Create an image" FontWeight="SemiBold"/>
                <TextBlock Text="Give your imagination a canvas" Classes="card-note"/>
              </StackPanel>
            </Button>
          </UniformGrid>
          <TextBlock Text="Choose a starting point, then make it your own." FontSize="11"
                     TextWrapping="Wrap" Foreground="{StaticResource Dim}" Margin="0,4,0,0"/>
        </StackPanel>
        </ScrollViewer>
        <Button x:Name="JumpToLatest" Content="↓ Jump to latest" IsVisible="False"
                Classes="quiet" FontSize="12" Padding="14,9" Margin="0,0,0,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                ToolTip.Tip="Return to the newest message and follow new replies."/>
        </Grid>
      </DockPanel>
    </Border>

    <!-- Graph + sidebar -->
    <!-- A scrolling stack, not a four-row grid. Four panels wanted ~660px of a ~420px
         column: the star-sized graph collapsed to nothing and WORKERS was squeezed to a
         sliver you could not read. Each panel now keeps a usable height and the column
         scrolls, which is honest about there being more here than fits. -->
    <ScrollViewer x:Name="AttentionPanel" Grid.Row="1" Grid.Column="1" Margin="0"
                  HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="10">

      <Border MinHeight="180" MaxHeight="380"
              Background="{StaticResource Panel}" CornerRadius="12" Padding="16">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="NEEDS YOUR ATTENTION" FontSize="11"
                     Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>
          <Grid>
          <ScrollViewer>
            <ItemsControl x:Name="AttentionList" ItemsSource="{Binding Attention}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:SidebarItem">
                  <StackPanel Margin="0,8">
                    <TextBlock Text="{Binding Headline}" TextWrapping="Wrap"
                               Foreground="{StaticResource Ink}"/>

                    <!-- The host first, then the link. A verdict on a headline is a
                         verdict on nothing: the panel showed a scouted title and hid the
                         one field that says what it is. -->
                    <TextBlock Text="{Binding Source}" FontSize="11" FontWeight="SemiBold"
                               IsVisible="{Binding CanOpen}" Foreground="#ABA5FF"/>
                    <TextBlock Text="{Binding Preview}" FontSize="11" TextWrapping="Wrap"
                               MaxLines="2" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Dim}" Margin="0,1,0,3"/>
                    <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource Dim}" Margin="0,2,0,6"/>
                    <WrapPanel>
                      <Button Content="read it" Tag="open" Margin="0,0,8,0" IsVisible="{Binding CanOpen}"
                              Padding="8,1" FontSize="11" Background="#45405B"
                              Foreground="#EEEEEE"
                              ToolTip.Tip="Open in the browser. Rate it after you have read it."/>

                      <!-- The actions live on the row. Every item here used to end in a
                           CLI incantation to type somewhere else, which is why nothing
                           got acted on and the panel read as a log. Always visible: a
                           control you have to discover is a control you do not use. -->
                      <StackPanel Orientation="Horizontal" Spacing="4"
                                  IsVisible="{Binding CanRate}">
                        <StackPanel.Styles>
                          <Style Selector="Button">
                            <Setter Property="Padding" Value="8,1"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Foreground" Value="#EEEEEE"/>
                            <Setter Property="Background" Value="#2A2A2A"/>
                          </Style>
                        </StackPanel.Styles>
                        <Button Content="good" Tag="good"
                                ToolTip.Tip="More like this. Trains the taste model."/>
                        <Button Content="meh" Tag="meh"/>
                        <Button Content="bad" Tag="bad"
                                ToolTip.Tip="Less like this. Trains the taste model."/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4"
                                  IsVisible="{Binding CanApprove}">
                        <Button Content="approve" Tag="approve" Padding="10,1" FontSize="11"
                                Background="#45405B" Foreground="#EEEEEE"/>
                        <Button Content="deny" Tag="deny" Padding="10,1" FontSize="11"
                                Background="#2A2A2A" Foreground="#EEEEEE"/>
                      </StackPanel>
                    </WrapPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                     HorizontalAlignment="Center" FontSize="12"
                     Foreground="{StaticResource Dim}"
                     Text="Nothing waiting on you."
                     IsVisible="{Binding Attention.Count, Converter={x:Static local:IsEmpty.instance}}"/>
          </Grid>
        </DockPanel>
      </Border>

      <Border MinHeight="180" MaxHeight="380"
              Background="{StaticResource Panel}" CornerRadius="12" Padding="16">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="WORKING BELIEFS" FontSize="11"
                     Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>
          <Grid>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Beliefs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:SidebarItem">
                  <StackPanel Margin="0,3">
                    <TextBlock Text="{Binding Headline}" TextWrapping="Wrap"
                               Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource Dim}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                     HorizontalAlignment="Center" FontSize="12"
                     Foreground="{StaticResource Dim}"
                     Text="Dami has not concluded anything yet."
                     IsVisible="{Binding Beliefs.Count, Converter={x:Static local:IsEmpty.instance}}"/>
          </Grid>
        </DockPanel>
      </Border>

    </StackPanel>
    </ScrollViewer>

  </Grid>
    </TabItem>
    <TabItem Classes="workspace" ToolTip.Tip="Plan &amp; tasks (Ctrl+2)">
      <TabItem.Header>
        <Grid ColumnDefinitions="24,*">
          <TextBlock Text="02" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Plan &amp; tasks" FontSize="13" VerticalAlignment="Center"/>
        </Grid>
      </TabItem.Header>
      <local:TaskBoardWorkspace x:Name="BoardWorkspace"/>
    </TabItem>

    <!-- A live, bounded view of the canonical event ledger. This deliberately reads
         PostgreSQL through dami-host rather than Elasticsearch: export lag or an Elastic
         outage must never make the desktop lie about what the runtime actually did. -->
    <TabItem Classes="workspace" ToolTip.Tip="Activity (Ctrl+3)">
      <TabItem.Header>
        <Grid ColumnDefinitions="24,*">
          <TextBlock Text="03" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Activity" FontSize="13" VerticalAlignment="Center"/>
        </Grid>
      </TabItem.Header>
      <Grid RowDefinitions="Auto,210,*" Margin="10">
        <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="8"
                Padding="12" Margin="0,0,0,10">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="1" Text="{Binding ObservabilityMessage}"
                       FontSize="11" Foreground="{StaticResource Dim}"
                       VerticalAlignment="Center" Margin="18,0,0,0"/>
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
              <TextBlock Text="OBSERVABILITY" FontSize="11" Foreground="{StaticResource Dim}"/>
              <TextBlock Text="what the runtime is doing now" FontSize="16"
                         Foreground="{StaticResource Ink}"/>
            </StackPanel>
            <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" Margin="-4,14,-4,0" ItemsSource="{Binding ObservabilityTiles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ObservabilityTile">
                  <Border Background="#151515" CornerRadius="6" Padding="12,10" Margin="4,0">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.RowSpan="2" Grid.Column="0" Text="{Binding Value}"
                                 FontSize="24" FontFamily="monospace" Margin="0,0,10,0"
                                 Foreground="{Binding IsAlert, Converter={x:Static local:FaultBrush.instance}}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11"
                                 FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" FontSize="10" TextWrapping="Wrap"
                                 Foreground="{StaticResource Dim}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8"
                Padding="12" Margin="0,0,0,10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="RUNTIME ACTIVITY · LAST TWO HOURS"
                       FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding ActivityMessage}" FontSize="11"
                       Foreground="{StaticResource Dim}" Margin="0,6,0,0"/>
            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Activity}"
                          Margin="16,0,0,0" Width="150">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ActivitySeries">
                  <Grid ColumnDefinitions="10,*,Auto" Margin="0,3">
                    <Rectangle Grid.Column="0" Width="8" Height="8" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Center" Fill="{Binding Stroke}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Margin="6,0,0,0"
                               Foreground="{StaticResource Dim}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Now}" FontSize="12"
                               FontFamily="monospace" Foreground="{Binding Stroke}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Background="#151515" CornerRadius="6" Padding="6">
              <Grid>
                <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Text="No activity data yet."
                           FontSize="12" Foreground="{StaticResource Dim}"
                           IsVisible="{Binding Activity.Count, Converter={x:Static local:IsEmpty.instance}}"/>
                <Viewbox Stretch="Fill">
                  <Canvas Width="1000" Height="200">
                    <ItemsControl ItemsSource="{Binding Activity}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas Width="1000" Height="200"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ActivitySeries">
                          <Canvas Width="1000" Height="200">
                            <Polygon Points="{Binding Area}" Fill="{Binding Fill}"/>
                            <Polyline Points="{Binding Line}" Stroke="{Binding Stroke}"
                                      StrokeThickness="2" StrokeLineCap="Round"
                                      StrokeJoin="Round"/>
                          </Canvas>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Canvas>
                </Viewbox>
              </Grid>
            </Border>
          </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="NEWEST DURABLE EVENTS"
                       FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>
            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="4,72,86,125,155,120,95,*" Margin="0,0,0,4">
              <TextBlock Grid.Column="1" Text="TIME" FontSize="10" Foreground="{StaticResource Dim}"/>
              <TextBlock Grid.Column="2" Text="TRACE" FontSize="10" Foreground="{StaticResource Dim}"/>
              <TextBlock Grid.Column="3" Text="ORIGIN" FontSize="10" Foreground="{StaticResource Dim}"/>
              <TextBlock Grid.Column="4" Text="ACTOR" FontSize="10" Foreground="{StaticResource Dim}"/>
              <TextBlock Grid.Column="5" Text="TYPE" FontSize="10" Foreground="{StaticResource Dim}"/>
              <TextBlock Grid.Column="6" Text="STATUS" FontSize="10" Foreground="{StaticResource Dim}"/>
              <TextBlock Grid.Column="7" Text="LABEL" FontSize="10" Foreground="{StaticResource Dim}"/>
            </Grid>
            <Grid>
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding ObservabilityEvents}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ObservabilityEvent">
                      <Grid ColumnDefinitions="4,72,86,125,155,120,95,*" Margin="0,2">
                        <Rectangle Grid.Column="0" Width="3" RadiusX="1.5" RadiusY="1.5"
                                   IsVisible="{Binding IsAlert}" Fill="#E0604F"/>
                        <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="11"
                                   FontFamily="monospace" Foreground="{StaticResource Dim}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Trace}" FontSize="11"
                                   FontFamily="monospace" Foreground="#ABA5FF"/>
                        <TextBlock Grid.Column="3" Text="{Binding Origin}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource Dim}"/>
                        <TextBlock Grid.Column="4" Text="{Binding Actor}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ink}"/>
                        <TextBlock Grid.Column="5" Text="{Binding Type}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Foreground="#B98CE0"/>
                        <TextBlock Grid.Column="6" Text="{Binding Status}" FontSize="11"
                                   Foreground="{Binding Status, Converter={x:Static local:StatusBrush.instance}}"/>
                        <TextBlock Grid.Column="7" Text="{Binding Label}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ink}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                         HorizontalAlignment="Center" TextAlignment="Center"
                         Text="No durable events in the current window."
                         FontSize="12" Foreground="{StaticResource Dim}"
                         IsVisible="{Binding ObservabilityEvents.Count, Converter={x:Static local:IsEmpty.instance}}"/>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>
    </TabItem>

    <!-- The proactive tier is what Dami does when Steve is not here, and it had no
         surface at all: three of eleven services had not run in five days and nothing
         said whether that was cadence or a fault. Full width because the useful part is
         not that a pass ran, it is what the pass did — the egress it made, what answered,
         what it surfaced — and that is a trace, not a line. Read-only: starting a pass is
         an operator's act at the CLI. -->
    <TabItem Classes="workspace" ToolTip.Tip="Workers (Ctrl+4)">
      <TabItem.Header>
        <Grid ColumnDefinitions="24,*">
          <TextBlock Text="04" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Workers" FontSize="13" VerticalAlignment="Center"/>
        </Grid>
      </TabItem.Header>
      <Grid RowDefinitions="Auto,*" Margin="10">

      <!-- Everything the runtime does is already in the event stream; nothing showed it
           as a shape. A rolling chart answers what a list cannot: whether anything is
           happening right now, and whether egress spikes when the scout wakes. All the
           series share one vertical scale, because per-series scaling would make a single
           tool call look as dramatic as forty trace events. -->
      <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="8"
              Padding="12" Margin="0,0,0,10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="RUNTIME ACTIVITY" FontSize="11"
                     Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding ActivityMessage}" FontSize="11"
                     Foreground="{StaticResource Dim}" Margin="0,6,0,0"/>
          <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Activity}"
                        Margin="16,0,0,0" Width="150">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:ActivitySeries">
                <Grid ColumnDefinitions="10,*,Auto" Margin="0,3">
                  <Rectangle Grid.Column="0" Width="8" Height="8" RadiusX="2" RadiusY="2"
                             VerticalAlignment="Center" Fill="{Binding Stroke}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Margin="6,0,0,0"
                             Foreground="{StaticResource Dim}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Now}" FontSize="12"
                             FontFamily="monospace" Foreground="{Binding Stroke}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Background="#151515" CornerRadius="6" Padding="6" Height="190">
            <Grid>
            <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontSize="12" Foreground="{StaticResource Dim}"
                       Text="No activity data. This runtime has no /activity endpoint yet — dami-host needs redeploying."
                       IsVisible="{Binding Activity.Count, Converter={x:Static local:IsEmpty.instance}}"/>
            <Viewbox Stretch="Fill">
              <Canvas Width="1000" Height="200">
                <ItemsControl ItemsSource="{Binding Activity}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas Width="1000" Height="200"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ActivitySeries">
                      <Canvas Width="1000" Height="200">
                        <Polygon Points="{Binding Area}" Fill="{Binding Fill}"/>
                        <Polyline Points="{Binding Line}" Stroke="{Binding Stroke}"
                                  StrokeThickness="2" StrokeLineCap="Round"
                                  StrokeJoin="Round"/>
                      </Canvas>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Canvas>
            </Viewbox>
            </Grid>
          </Border>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="300,340,*">

        <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8"
                Padding="12" Margin="0,0,5,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="PROACTIVE SERVICES" FontSize="11"
                       Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>
            <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="11"
                       Margin="0,8,0,0" Foreground="{StaticResource Dim}"
                       Text="Read-only. A pass is started by the tier's own schedule, or by hand at the CLI."/>
            <ListBox x:Name="WorkerList" ItemsSource="{Binding Workers}"
                     Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:WorkerRow">
                  <StackPanel Margin="2,6">
                    <TextBlock Text="{Binding ServiceName}" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="11"
                               Foreground="{Binding LastStatus, Converter={x:Static local:StatusBrush.instance}}"/>
                    <!-- Age alone cannot say whether a service is late. Weekly and five
                         days ago is healthy; nightly and five days ago is not. -->
                    <TextBlock Text="{Binding Schedule}" FontSize="11"
                               Foreground="{Binding IsOverdue, Converter={x:Static local:OverdueBrush.instance}}"/>

                    <!-- One block per pass, oldest left, height by duration and colour by
                         outcome. A service that has been alerting or slowing down shows it
                         here without opening anything, which is the difference between a
                         list you browse and one you monitor. -->
                    <ItemsControl ItemsSource="{Binding Strip}" Margin="0,5,0,2">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="2"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:WorkerRun">
                          <Border Width="7" Height="24" Background="#111111" CornerRadius="2"
                                  ToolTip.Tip="{Binding Outcome}">
                            <Rectangle Width="7" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"
                                       Height="{Binding BarHeight}"
                                       Fill="{Binding Converter={x:Static local:RunBrush.instance}}"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Totals}" FontSize="11"
                               Foreground="{StaticResource Dim}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8"
                Padding="12" Margin="5,0,5,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="RUNS" FontSize="11"
                       Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>
            <Grid>
              <ListBox x:Name="WorkerRunList" ItemsSource="{Binding SelectedWorkerRuns}"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:WorkerRun">
                    <Grid ColumnDefinitions="4,*" Margin="0,4">
                      <!-- A pass can alert and still be Completed, so the mark is driven by
                           the alert count rather than the status. Without it the bad pass
                           can only be found by opening every one. -->
                      <Rectangle Grid.Column="0" Width="3" RadiusX="1.5" RadiusY="1.5"
                                 IsVisible="{Binding HasAlerts}" Fill="#E0604F"/>
                      <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding When}" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="{Binding Outcome}" FontSize="11" FontFamily="monospace"
                                   Foreground="{Binding Converter={x:Static local:RunBrush.instance}}"/>
                        <TextBlock FontSize="11" FontFamily="monospace"
                                   Foreground="{StaticResource Dim}">
                          <Run Text="trace "/><Run Text="{Binding Trace}"/>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                         HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         FontSize="12" Margin="12,0" Foreground="{StaticResource Dim}"
                         Text="Pick a service to see its passes."
                         IsVisible="{Binding SelectedWorkerRuns.Count, Converter={x:Static local:IsEmpty.instance}}"/>
            </Grid>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8"
                Padding="12" Margin="5,0,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="WHAT THAT PASS DID" FontSize="11"
                       Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>

            <!-- The headline first: what the pass cost and what it produced. A reader
                 should not have to count rows to learn that a scout pass surfaced three
                 items and hit one rate limit. -->
            <Border DockPanel.Dock="Top" Background="#151515" CornerRadius="6"
                    Padding="12,10" Margin="0,0,0,10"
                    IsVisible="{Binding PassSummary.HasRun}">
              <StackPanel Orientation="Horizontal" Spacing="28">
                <StackPanel>
                  <TextBlock Text="{Binding PassSummary.Duration}" FontSize="20"
                             Foreground="{StaticResource Ink}"/>
                  <TextBlock Text="elapsed" FontSize="11" Foreground="{StaticResource Dim}"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="{Binding PassSummary.Produced}" FontSize="20"
                             Foreground="#ABA5FF"/>
                  <TextBlock Text="produced" FontSize="11" Foreground="{StaticResource Dim}"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="{Binding PassSummary.Egress}" FontSize="20"
                             Foreground="#ABA5FF"/>
                  <TextBlock Text="reached out" FontSize="11" Foreground="{StaticResource Dim}"/>
                </StackPanel>
                <StackPanel IsVisible="{Binding PassSummary.HasAlerts}">
                  <TextBlock Text="{Binding PassSummary.Alerts}" FontSize="20" Foreground="#E0604F"/>
                  <TextBlock Text="{Binding PassSummary.AlertLine}" FontSize="11"
                             Foreground="#E0604F"/>
                </StackPanel>
                <TextBlock Text="{Binding WorkerTraceMessage}" FontSize="11" FontFamily="monospace"
                           VerticalAlignment="Bottom" Foreground="{StaticResource Dim}"/>
              </StackPanel>
            </Border>

            <!-- A ruler, so the track's positions mean something. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="58,132,300,*" Margin="0,0,0,4"
                  IsVisible="{Binding PassSummary.HasRun}">
              <Grid Grid.Column="2" ColumnDefinitions="*,*,*,*" Margin="0,0,12,0">
                <TextBlock Grid.Column="0" Text="0s" FontSize="10" FontFamily="monospace"
                           Foreground="{StaticResource Dim}"/>
                <TextBlock Grid.Column="3" Text="{Binding PassSummary.Duration}" FontSize="10"
                           FontFamily="monospace" TextAlignment="Right"
                           Foreground="{StaticResource Dim}"/>
              </Grid>
            </Grid>

            <Grid>
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding WorkerTrace}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PassEvent">
                      <Grid ColumnDefinitions="58,132,300,*" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding Offset}" FontFamily="monospace"
                                   FontSize="11" TextAlignment="Right" Margin="0,0,10,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Type}" FontFamily="monospace"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{Binding Converter={x:Static local:PassAccent.instance}}"/>

                        <!-- The track. Each bar is placed by when it happened and sized by
                             the wait that followed, so the pass reads as a shape: a scout
                             sitting four seconds on one feed is a wide bar with empty
                             space either side, which rows could never show. -->
                        <Border Grid.Column="2" Background="#111111" CornerRadius="3"
                                Height="16" VerticalAlignment="Center" Margin="0,0,12,0">
                          <Rectangle Height="10" RadiusX="3" RadiusY="3"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="{Binding BarMargin}" Width="{Binding BarWidth}"
                                     Fill="{Binding Converter={x:Static local:PassAccent.instance}}"/>
                        </Border>

                        <TextBlock Grid.Column="3" Text="{Binding Label}" FontSize="12"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{StaticResource Ink}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                         HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         FontSize="12" Margin="12,0" Foreground="{StaticResource Dim}"
                         Text="Pick a pass to replay exactly what it did."
                         IsVisible="{Binding WorkerTrace.Count, Converter={x:Static local:IsEmpty.instance}}"/>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>
      </Grid>
    </TabItem>

    <TabItem Classes="workspace" ToolTip.Tip="Health (Ctrl+5)">
      <TabItem.Header>
        <Grid ColumnDefinitions="24,*">
          <TextBlock Text="05" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Health" FontSize="13" VerticalAlignment="Center"/>
        </Grid>
      </TabItem.Header>
      <Grid RowDefinitions="Auto,Auto,*" Margin="10">

        <!-- Headline numbers, with the load status and a manual refresh beside them.
             One snapshot feeds everything below; refresh is the only round trip. -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="8"
                Padding="12" Margin="0,0,0,10">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
            <Button x:Name="FitnessRefresh" Grid.Column="1" Content="refresh"
                    Padding="12,4" Background="#45405B" Foreground="{StaticResource Ink}"
                    VerticalAlignment="Center"/>
            <TextBlock Grid.Column="0" Text="{Binding FitnessMessage}" FontSize="11"
                       Foreground="{StaticResource Dim}" VerticalAlignment="Center"
                       Margin="0,0,12,0" TextWrapping="Wrap"/>
            <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" ItemsSource="{Binding FitnessTiles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:FitnessTile">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="10"
                               Foreground="{StaticResource Dim}"/>
                    <TextBlock Text="{Binding Value}" FontSize="20" FontFamily="monospace"
                               Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource Dim}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <!-- Three trends. Weight is min–max scaled; the weekly totals start at zero. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,0,0,10">
          <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8"
                  Padding="12" Margin="0,0,8,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="BODY WEIGHT" FontSize="11"
                         Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
              <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding WeightChart}"
                            Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:FitnessSeries">
                    <DockPanel>
                      <TextBlock Text="{Binding Now}" FontSize="11" FontFamily="monospace"
                                 Foreground="{Binding Stroke}"/>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                  HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Floor}" FontSize="10"
                                   Foreground="{StaticResource Dim}"/>
                        <TextBlock Text=" – " FontSize="10" Foreground="{StaticResource Dim}"/>
                        <TextBlock Text="{Binding Ceiling}" FontSize="10"
                                   Foreground="{StaticResource Dim}"/>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="#151515" CornerRadius="6" Padding="6" Height="150">
                <Grid>
                  <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                             HorizontalAlignment="Center" FontSize="12"
                             Foreground="{StaticResource Dim}" Text="no weigh-ins"
                             IsVisible="{Binding WeightChart.Count, Converter={x:Static local:IsEmpty.instance}}"/>
                  <Viewbox Stretch="Fill">
                    <Canvas Width="1000" Height="200">
                      <ItemsControl ItemsSource="{Binding WeightChart}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><Canvas Width="1000" Height="200"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:FitnessSeries">
                            <Canvas Width="1000" Height="200">
                              <Polygon Points="{Binding Area}" Fill="{Binding Fill}"/>
                              <Polyline Points="{Binding Line}" Stroke="{Binding Stroke}"
                                        StrokeThickness="2" StrokeLineCap="Round"
                                        StrokeJoin="Round"/>
                            </Canvas>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Canvas>
                  </Viewbox>
                </Grid>
              </Border>
            </DockPanel>
          </Border>

          <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8"
                  Padding="12" Margin="0,0,8,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="WEEKLY TONNAGE" FontSize="11"
                         Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
              <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding TonnageChart}"
                            Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:FitnessSeries">
                    <DockPanel>
                      <TextBlock Text="{Binding Now}" FontSize="11" FontFamily="monospace"
                                 Foreground="{Binding Stroke}"/>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Ceiling}" FontSize="10"
                                 Foreground="{StaticResource Dim}" HorizontalAlignment="Right"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="#151515" CornerRadius="6" Padding="6" Height="150">
                <Grid>
                  <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                             HorizontalAlignment="Center" FontSize="12"
                             Foreground="{StaticResource Dim}" Text="no resistance work"
                             IsVisible="{Binding TonnageChart.Count, Converter={x:Static local:IsEmpty.instance}}"/>
                  <Viewbox Stretch="Fill">
                    <Canvas Width="1000" Height="200">
                      <ItemsControl ItemsSource="{Binding TonnageChart}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><Canvas Width="1000" Height="200"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:FitnessSeries">
                            <Canvas Width="1000" Height="200">
                              <Polygon Points="{Binding Area}" Fill="{Binding Fill}"/>
                              <Polyline Points="{Binding Line}" Stroke="{Binding Stroke}"
                                        StrokeThickness="2" StrokeLineCap="Round"
                                        StrokeJoin="Round"/>
                            </Canvas>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Canvas>
                  </Viewbox>
                </Grid>
              </Border>
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8"
                  Padding="12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="WEEKLY CARDIO" FontSize="11"
                         Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
              <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding CardioChart}"
                            Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:FitnessSeries">
                    <DockPanel>
                      <TextBlock Text="{Binding Now}" FontSize="11" FontFamily="monospace"
                                 Foreground="{Binding Stroke}"/>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Ceiling}" FontSize="10"
                                 Foreground="{StaticResource Dim}" HorizontalAlignment="Right"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="#151515" CornerRadius="6" Padding="6" Height="150">
                <Grid>
                  <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                             HorizontalAlignment="Center" FontSize="12"
                             Foreground="{StaticResource Dim}" Text="no cardio"
                             IsVisible="{Binding CardioChart.Count, Converter={x:Static local:IsEmpty.instance}}"/>
                  <Viewbox Stretch="Fill">
                    <Canvas Width="1000" Height="200">
                      <ItemsControl ItemsSource="{Binding CardioChart}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><Canvas Width="1000" Height="200"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:FitnessSeries">
                            <Canvas Width="1000" Height="200">
                              <Polygon Points="{Binding Area}" Fill="{Binding Fill}"/>
                              <Polyline Points="{Binding Line}" Stroke="{Binding Stroke}"
                                        StrokeThickness="2" StrokeLineCap="Round"
                                        StrokeJoin="Round"/>
                            </Canvas>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Canvas>
                  </Viewbox>
                </Grid>
              </Border>
            </DockPanel>
          </Border>
        </Grid>

        <!-- Pick a lift, see its progression; suggestions and the recent log beside it. -->
        <Grid Grid.Row="2" ColumnDefinitions="260,*,340">
          <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8"
                  Padding="12" Margin="0,0,8,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="EXERCISES" FontSize="11"
                         Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
              <ListBox x:Name="FitnessExerciseList" ItemsSource="{Binding FitnessExercises}"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:FitnessExerciseChoice">
                    <TextBlock Text="{Binding Label}" FontSize="12"
                               Foreground="{StaticResource Ink}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8"
                  Padding="12" Margin="0,0,8,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="PROGRESSION · ESTIMATED 1RM" FontSize="11"
                         Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
              <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding ExerciseChart}"
                            Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:FitnessSeries">
                    <DockPanel>
                      <TextBlock Text="{Binding Name}" FontSize="11"
                                 Foreground="{StaticResource Dim}"/>
                      <TextBlock Text="  " FontSize="11"/>
                      <TextBlock Text="{Binding Now}" FontSize="11" FontFamily="monospace"
                                 Foreground="{Binding Stroke}"/>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                  HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Floor}" FontSize="10"
                                   Foreground="{StaticResource Dim}"/>
                        <TextBlock Text=" – " FontSize="10" Foreground="{StaticResource Dim}"/>
                        <TextBlock Text="{Binding Ceiling}" FontSize="10"
                                   Foreground="{StaticResource Dim}"/>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="#151515" CornerRadius="6" Padding="6">
                <Grid>
                  <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                             HorizontalAlignment="Center" FontSize="12"
                             Foreground="{StaticResource Dim}"
                             Text="pick an exercise with logged working sets"
                             IsVisible="{Binding ExerciseChart.Count, Converter={x:Static local:IsEmpty.instance}}"/>
                  <Viewbox Stretch="Fill">
                    <Canvas Width="1000" Height="200">
                      <ItemsControl ItemsSource="{Binding ExerciseChart}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><Canvas Width="1000" Height="200"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:FitnessSeries">
                            <Canvas Width="1000" Height="200">
                              <Polygon Points="{Binding Area}" Fill="{Binding Fill}"/>
                              <Polyline Points="{Binding Line}" Stroke="{Binding Stroke}"
                                        StrokeThickness="2" StrokeLineCap="Round"
                                        StrokeJoin="Round"/>
                            </Canvas>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Canvas>
                  </Viewbox>
                </Grid>
              </Border>
            </DockPanel>
          </Border>

          <Grid Grid.Column="2" RowDefinitions="*,*">
            <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="8"
                    Padding="12" Margin="0,0,0,8">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="SUGGESTIONS" FontSize="11"
                           Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
                <ScrollViewer>
                  <Grid>
                    <TextBlock FontSize="12" Foreground="{StaticResource Dim}"
                               Text="nothing to say — which is the point"
                               IsVisible="{Binding FitnessSuggestions.Count, Converter={x:Static local:IsEmpty.instance}}"/>
                    <ItemsControl ItemsSource="{Binding FitnessSuggestions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:FitnessInsight">
                          <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="{Binding Detail}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{StaticResource Dim}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8"
                    Padding="12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="RECENT SESSIONS" FontSize="11"
                           Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding FitnessSessions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:FitnessSessionRow">
                        <Grid ColumnDefinitions="52,90,*" Margin="0,2">
                          <TextBlock Grid.Column="0" Text="{Binding When}" FontSize="11"
                                     FontFamily="monospace" Foreground="{StaticResource Dim}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11"
                                     Foreground="{StaticResource Ink}"/>
                          <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11"
                                     Foreground="{StaticResource Dim}"
                                     TextTrimming="CharacterEllipsis"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem Classes="workspace" ToolTip.Tip="Gallery (Ctrl+6)">
      <TabItem.Header>
        <Grid ColumnDefinitions="24,*">
          <TextBlock Text="06" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Gallery" FontSize="13" VerticalAlignment="Center"/>
        </Grid>
      </TabItem.Header>
      <Grid x:Name="GallerySurface" RowDefinitions="Auto,*" Margin="10">
        <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="8"
                Padding="12" Margin="0,0,0,10">
          <StackPanel Spacing="14">
            <StackPanel>
              <TextBlock Text="DAMI · PORTRAIT GALLERY" FontSize="16" FontWeight="SemiBold"
                         Foreground="{StaticResource Ink}"/>
              <TextBlock Text="{Binding GalleryMessage}" FontSize="11"
                         Foreground="{StaticResource Dim}"/>
            </StackPanel>
          <DockPanel>
            <Button x:Name="GalleryRefresh" DockPanel.Dock="Right" Content="refresh"
                    Padding="12,4" Background="#2A2A2A" Foreground="{StaticResource Ink}"/>
            <Button x:Name="GalleryImport" DockPanel.Dock="Right" Content="import images…"
                    Margin="0,0,8,0" Padding="12,4" Background="#2A2A2A"
                    Foreground="{StaticResource Ink}"/>
            <CheckBox x:Name="GalleryShowHidden" DockPanel.Dock="Right" Content="hidden" Margin="0,0,8,0"
                      Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
            <CheckBox x:Name="GalleryFavouritesOnly" DockPanel.Dock="Right" Content="♥ only" Margin="0,0,8,0"
                      Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
            <ComboBox x:Name="GallerySourceFilter" DockPanel.Dock="Right" Width="130" Margin="0,0,8,0"
                      SelectedIndex="0" VerticalAlignment="Center">
              <ComboBoxItem Content="all sources"/>
              <ComboBoxItem Content="chat"/>
              <ComboBoxItem Content="discord"/>
              <ComboBoxItem Content="scheduled"/>
              <ComboBoxItem Content="proactive"/>
              <ComboBoxItem Content="imported"/>
            </ComboBox>
            <TextBox x:Name="GallerySearch" MinWidth="160" Margin="0,0,8,0"
                     PlaceholderText="search: balcony at dusk, red dress, reading…"
                     Background="#151515" BorderBrush="#353535" Foreground="{StaticResource Ink}"/>

          </DockPanel>
          </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="3*,2*">
          <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8"
                  Padding="10" Margin="0,0,8,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ListBox x:Name="GalleryList" ItemsSource="{Binding GalleryImages}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:GalleryImageCard">
                    <Border Width="188" Margin="4" Background="#151515" CornerRadius="7"
                            ClipToBounds="True">
                      <StackPanel>
                        <Image Source="{Binding Image}" Width="188" Height="250"
                               Stretch="UniformToFill"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="9,7,9,2">
                          <TextBlock Grid.Column="0" Text="{Binding Date}" FontSize="10"
                                     Foreground="{StaticResource Dim}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Badge}" FontSize="10"
                                     Foreground="#ABA5FF"/>
                        </Grid>
                        <TextBlock Text="{Binding Description}" FontSize="10" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                   Margin="9,0,9,9" Foreground="{StaticResource Dim}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Border>

          <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="14">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="300,Auto,Auto,Auto">
              <Border Grid.Row="0" Background="#151515" CornerRadius="7" ClipToBounds="True">
                <Button Tag="gallery-image" Classes="image-preview" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        ToolTip.Tip="Open image · zoom and pan" AutomationProperties.Name="Open selected Gallery image">
                  <Image Source="{Binding SelectedGalleryImage.Image}" Stretch="Uniform"/>
                </Button>
              </Border>
              <StackPanel Grid.Row="1" Margin="0,10,0,12">
                <WrapPanel>
                  <Button x:Name="GallerySimilar" Content="find similar"
                          Padding="10,3" Background="#2A2A2A" Foreground="{StaticResource Ink}"/>
                  <Button x:Name="GalleryHide" Content="hide" Margin="0,0,6,0"
                          Padding="10,3" Background="#2A2A2A" Foreground="{StaticResource Ink}"/>
                  <Button x:Name="GalleryFavourite" Content="♥" Margin="0,0,6,0"
                          Padding="10,3" Background="#2A2A2A" Foreground="{StaticResource Ink}"/>
                  <TextBlock Text="{Binding SelectedGalleryImage.Date}" FontSize="12"
                             VerticalAlignment="Center" Foreground="{StaticResource Ink}"/>
                </WrapPanel>
                <TextBlock Text="{Binding SelectedGalleryImage.Marks}" FontSize="11" Margin="0,4,0,0"
                           Foreground="#E0A0B0"/>
                <Button x:Name="GalleryLineage" Content="{Binding SelectedGalleryImage.Lineage}"
                        IsVisible="{Binding SelectedGalleryImage.DerivedFrom, Converter={x:Static ObjectConverters.IsNotNull}}"
                        FontSize="10" Padding="0" Background="Transparent" Foreground="#ABA5FF"
                        HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding SelectedGalleryImage.Caption}" FontSize="11"
                           TextWrapping="Wrap" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="{Binding SelectedGalleryImage.TagLine}" FontSize="10"
                           TextWrapping="Wrap" Foreground="#ABA5FF"/>
                <TextBlock Text="{Binding SelectedGalleryImage.Prompt}" FontSize="11"
                           TextWrapping="Wrap" Foreground="{StaticResource Dim}"/>
              </StackPanel>
              <Border Grid.Row="2" Background="#151515" BorderBrush="#353535"
                      BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid RowDefinitions="Auto,Auto">
                  <TextBox x:Name="GalleryPrompt" Grid.Row="0" AcceptsReturn="True"
                           TextWrapping="Wrap" MinHeight="62" MaxHeight="110"
                           PlaceholderText="a candid scene, action, mood, and setting…"
                           Background="Transparent" BorderThickness="0"
                           Foreground="{StaticResource Ink}"/>
                  <Button x:Name="GalleryGenerate" Grid.Row="1" Content="create new Dami portrait"
                          HorizontalAlignment="Right" Margin="0,8,0,0" Padding="14,6"
                          Background="#45405B" Foreground="{StaticResource Ink}"/>
                </Grid>
              </Border>
              <Border Grid.Row="3" Background="#151515" BorderBrush="#353535"
                      BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox x:Name="GalleryEdit" Grid.Column="0"
                           PlaceholderText="change the selected picture: golden hour, red dress, in the workshop…"
                           Background="Transparent" BorderThickness="0"
                           Foreground="{StaticResource Ink}"/>
                  <Button x:Name="GalleryEditRun" Grid.Column="1" Content="edit selected"
                          Margin="8,0,0,0" Padding="14,6"
                          Background="#45405B" Foreground="{StaticResource Ink}"/>
                </Grid>
              </Border>
            </Grid>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem Classes="workspace" ToolTip.Tip="Network (Ctrl+7)">
      <TabItem.Header>
        <Grid ColumnDefinitions="24,*">
          <TextBlock Text="07" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Network" FontSize="13" VerticalAlignment="Center"/>
        </Grid>
      </TabItem.Header>
      <Grid RowDefinitions="Auto,Auto,*" Margin="10">

        <!-- The deterministic panels poll every 20 s; only the analysis costs a model
             call, so it runs on load and on the button, never on the timer. -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="8"
                Padding="12" Margin="0,0,0,10">
          <DockPanel>
            <Button x:Name="NetworkAnalyze" DockPanel.Dock="Right" Content="analyze"
                    Padding="12,4" Background="#45405B" Foreground="{StaticResource Ink}"
                    VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding NetworkMessage}" FontSize="11"
                       Foreground="{StaticResource Dim}" VerticalAlignment="Center"
                       Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="380"/>
            <ItemsControl ItemsSource="{Binding NetworkTiles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="28"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:NetworkTile">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="10"
                               Foreground="{StaticResource Dim}"/>
                    <TextBlock Text="{Binding Value}" FontSize="20" FontFamily="monospace"
                               Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="10"
                               Foreground="{StaticResource Dim}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,10">
          <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8"
                  Padding="12" Margin="0,0,8,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="RUNTIME EGRESS · LAST 30 MIN"
                         FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
              <Border Background="#151515" CornerRadius="6" Padding="6" Height="130">
                <Grid>
                  <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                             HorizontalAlignment="Center" FontSize="12"
                             Foreground="{StaticResource Dim}" Text="no egress data"
                             IsVisible="{Binding NetworkEgress.Count, Converter={x:Static local:IsEmpty.instance}}"/>
                  <Viewbox Stretch="Fill">
                    <Canvas Width="1000" Height="200">
                      <ItemsControl ItemsSource="{Binding NetworkEgress}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><Canvas Width="1000" Height="200"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:ActivitySeries">
                            <Canvas Width="1000" Height="200">
                              <Polygon Points="{Binding Area}" Fill="{Binding Fill}"/>
                              <Polyline Points="{Binding Line}" Stroke="{Binding Stroke}"
                                        StrokeThickness="2" StrokeLineCap="Round"
                                        StrokeJoin="Round"/>
                            </Canvas>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Canvas>
                  </Viewbox>
                </Grid>
              </Border>
            </DockPanel>
          </Border>

          <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8"
                  Padding="12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="FAULTS BY SWEEP" FontSize="11"
                         Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
              <Border Background="#151515" CornerRadius="6" Padding="6" Height="130">
                <Grid>
                  <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                             HorizontalAlignment="Center" FontSize="12"
                             Foreground="{StaticResource Dim}" Text="no sweeps recorded"
                             IsVisible="{Binding NetworkProblemChart.Count, Converter={x:Static local:IsEmpty.instance}}"/>
                  <Viewbox Stretch="Fill">
                    <Canvas Width="1000" Height="200">
                      <ItemsControl ItemsSource="{Binding NetworkProblemChart}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><Canvas Width="1000" Height="200"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:FitnessSeries">
                            <Canvas Width="1000" Height="200">
                              <Polygon Points="{Binding Area}" Fill="{Binding Fill}"/>
                              <Polyline Points="{Binding Line}" Stroke="{Binding Stroke}"
                                        StrokeThickness="2" StrokeLineCap="Round"
                                        StrokeJoin="Round"/>
                            </Canvas>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Canvas>
                  </Viewbox>
                </Grid>
              </Border>
            </DockPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,300,360">
          <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8"
                  Padding="12" Margin="0,0,8,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="LATEST SWEEP" FontSize="11"
                         Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding NetworkLatest}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:NetworkFactRow">
                      <Grid ColumnDefinitions="10,88,*" Margin="0,2">
                        <Rectangle Grid.Column="0" Width="8" Height="8" RadiusX="2" RadiusY="2"
                                   VerticalAlignment="Center"
                                   Fill="{Binding IsProblem, Converter={x:Static local:FaultBrush.instance}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11"
                                   FontFamily="monospace" Foreground="{StaticResource Dim}"
                                   Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="12"
                                   Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8"
                  Padding="12" Margin="0,0,8,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="SINCE LAST SWEEP" FontSize="11"
                         Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
              <ScrollViewer>
                <Grid>
                  <TextBlock FontSize="12" Foreground="{StaticResource Dim}"
                             Text="nothing changed"
                             IsVisible="{Binding NetworkChanges.Count, Converter={x:Static local:IsEmpty.instance}}"/>
                  <ItemsControl ItemsSource="{Binding NetworkChanges}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:NetworkChange">
                        <Grid ColumnDefinitions="66,*" Margin="0,2">
                          <TextBlock Grid.Column="0" Text="{Binding Kind}" FontSize="11"
                                     FontFamily="monospace" Foreground="{StaticResource Dim}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12"
                                     Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8"
                  Padding="12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="ANALYSIS · LOCAL MODEL, SPECULATION LABELED"
                         FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
              <ScrollViewer>
                <TextBlock Text="{Binding NetworkAnalysis}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource Ink}"/>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </TabItem>
    <TabItem Classes="workspace" ToolTip.Tip="Research (Ctrl+8)">
      <TabItem.Header>
        <Grid ColumnDefinitions="24,*">
          <TextBlock Text="08" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Research" FontSize="13" VerticalAlignment="Center"/>
        </Grid>
      </TabItem.Header>
      <local:ResearchWorkspace x:Name="ResearchPage"/>
    </TabItem>
  </TabControl>

  <!-- An overlay in the visual tree, not a Popup. A Popup is an OS-level window that
       needs a placement target and silently renders nothing without one — it opened
       correctly here and was invisible. This cannot fail to show, and "floating" never
       required a real window. -->
  <Border x:Name="AskPopup" IsVisible="False"
          HorizontalAlignment="Left" VerticalAlignment="Top"
          Background="#1B1B1B" BorderBrush="#454545" BorderThickness="1"
          CornerRadius="8" Padding="14" Width="460" BoxShadow="0 8 24 0 #99000000">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <TextBlock Grid.Column="0" Text="ASK ABOUT THIS" FontSize="11"
                   Foreground="{StaticResource Dim}"/>
        <Button Grid.Column="1" x:Name="AskClose" Content="✕" Padding="6,0" FontSize="11"
                Background="Transparent" Foreground="{StaticResource Dim}"/>
      </Grid>
      <TextBlock DockPanel.Dock="Top" x:Name="AskSubject" TextWrapping="Wrap"
                 MaxLines="3" TextTrimming="CharacterEllipsis" FontSize="11"
                 Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <TextBox x:Name="AskInput" Grid.Column="0" PlaceholderText="what do you want to know?"
                 Background="#151515" Foreground="{StaticResource Ink}" BorderBrush="#353535"/>
        <Button x:Name="AskButton" Grid.Column="1" Content="ask" Margin="8,0,0,0"
                Background="#45405B" Foreground="{StaticResource Ink}" Padding="12,4"/>
      </Grid>
      <ScrollViewer MaxHeight="300">
        <TextBlock x:Name="AskAnswer" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource Ink}"/>
      </ScrollViewer>
    </DockPanel>
  </Border>
  <Grid x:Name="CommandOverlay" KeyboardNavigation.TabNavigation="Cycle" IsVisible="False" Background="#BF111111" ZIndex="20">
    <Border Width="620" VerticalAlignment="Top" Margin="0,70,0,0" Padding="22"
            Background="#242424" BorderBrush="#484848" BorderThickness="1" CornerRadius="18"
            BoxShadow="0 18 60 0 #88000000">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="Where would you like to go?" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
            <TextBlock Text="Find a workspace or a quick action." FontSize="12" Foreground="{StaticResource Dim}"/>
          </StackPanel>
          <Button x:Name="CommandClose" Grid.Column="1" Content="Esc" Classes="quiet" Padding="10,5" VerticalAlignment="Top"/>
        </Grid>
        <TextBox x:Name="CommandSearch" PlaceholderText="Search pages and actions…" FontSize="15" Padding="12"/>
        <ListBox x:Name="CommandResults" MaxHeight="360" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:WorkspaceCommand">
              <Grid ColumnDefinitions="*,Auto" Margin="6,7">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                  <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Dim}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Shortcut}" FontSize="11" Margin="16,0,0,0"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="CommandEmpty" Text="No matching actions. Try ‘chat’, ‘tasks’, or ‘focus’."
                   IsVisible="False" Foreground="{StaticResource Dim}" Margin="8,12"/>
        <TextBlock Text="↑ ↓ to browse    Enter to open    Esc to return" FontSize="11" Foreground="{StaticResource Dim}"/>
      </StackPanel>
    </Border>
  </Grid>
  </Panel>
  </DockPanel>
  <Grid x:Name="ImageOverlay" IsVisible="False" Background="#ED101010" ZIndex="50" KeyboardNavigation.TabNavigation="Cycle">
    <Border Margin="24" Padding="18" Background="#1C1C1C" CornerRadius="16" BorderBrush="#454545" BorderThickness="1">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,16">
          <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,20,0">
            <TextBlock Text="IMAGE PREVIEW" FontSize="10" LetterSpacing="2" Foreground="{StaticResource Accent}"/>
            <TextBlock x:Name="ImageTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button x:Name="ImageFit" Content="Fit" Classes="quiet" ToolTip.Tip="Fit the whole image (0)"/>
            <Button x:Name="ImageActual" Content="100%" Classes="quiet" ToolTip.Tip="Actual pixel size (1)"/>
            <Button x:Name="ImageZoomOut" Content="−" Classes="quiet" ToolTip.Tip="Zoom out (−)" AutomationProperties.Name="Zoom out"/>
            <TextBlock x:Name="ImageScale" Width="60" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
            <Button x:Name="ImageZoomIn" Content="+" Classes="quiet" ToolTip.Tip="Zoom in (+)" AutomationProperties.Name="Zoom in"/>
            <Button x:Name="ImageClose" Content="Close  ×" Classes="quiet" Margin="12,0,0,0" ToolTip.Tip="Close image preview (Esc)"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#111111" CornerRadius="10" ClipToBounds="True">
          <local:ImageViewer x:Name="ImageCanvas" Cursor="SizeAll" AutomationProperties.Name="Image preview; scroll to zoom and drag to pan"/>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="2,14,2,0">
          <TextBlock x:Name="ImageDetails" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,0,24,0"/>
          <TextBlock Grid.Column="1" Text="Scroll to zoom · Drag or arrow keys to pan · Esc to close" FontSize="11" Foreground="{StaticResource Dim}"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
  </Panel>
</Window>
