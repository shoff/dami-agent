<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dami</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>dami-cli</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Dami.Persistence/Dami.Persistence.csproj" />
    <ProjectReference Include="../Dami.Providers/Dami.Providers.csproj" />
    <ProjectReference Include="../Dami.Core/Dami.Core.csproj" />
    <ProjectReference Include="../Dami.Vision/Dami.Vision.csproj" />
    <ProjectReference Include="../Dami.Proactive/Dami.Proactive.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
