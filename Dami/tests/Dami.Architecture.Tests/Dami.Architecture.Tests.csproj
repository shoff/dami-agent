<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <!--
    Referenced so the reflection-based tests have assemblies to inspect. The
    layering tests do NOT depend on these references: they read the .csproj
    dependency graph from disk, so they cover every project in the solution,
    including ones this project has never heard of.
  -->
  <ItemGroup>
    <!-- Every assembly the rules name. AssemblyProbe loads by name and silently skips
         what is not in the output directory, so an unreferenced project is a rule that
         inspects nothing and passes forever — the "largely vacuous" failure this suite
         already has a scar from. Referencing them is what makes the rules real. -->
    <ProjectReference Include="../../src/Dami.Contracts/Dami.Contracts.csproj" />
    <ProjectReference Include="../../src/Dami.Core/Dami.Core.csproj" />
    <ProjectReference Include="../../src/Dami.Persistence/Dami.Persistence.csproj" />
    <ProjectReference Include="../../src/Dami.Privacy/Dami.Privacy.csproj" />
    <ProjectReference Include="../../src/Dami.Providers/Dami.Providers.csproj" />
    <ProjectReference Include="../../src/Dami.Proactive/Dami.Proactive.csproj" />
    <ProjectReference Include="../../src/Dami.Capabilities/Dami.Capabilities.csproj" />
    <ProjectReference Include="../../src/Dami.Capabilities.Native/Dami.Capabilities.Native.csproj" />
    <ProjectReference Include="../../src/Dami.Capabilities.Mcp/Dami.Capabilities.Mcp.csproj" />
    <ProjectReference Include="../../src/Dami.Capabilities.Sandboxed/Dami.Capabilities.Sandboxed.csproj" />
    <ProjectReference Include="../../src/Dami.Capabilities.Skills/Dami.Capabilities.Skills.csproj" />
    <ProjectReference Include="../../src/Dami.Vision/Dami.Vision.csproj" />
    <ProjectReference Include="../../src/Dami.Authentication/Dami.Authentication.csproj" />
    <ProjectReference Include="../../src/Dami.Transport/Dami.Transport.csproj" />
    <ProjectReference Include="../../src/Dami.Gateway.Discord/Dami.Gateway.Discord.csproj" />
    <ProjectReference Include="../../src/Dami.Host.Discord/Dami.Host.Discord.csproj" />
  </ItemGroup>

</Project>
