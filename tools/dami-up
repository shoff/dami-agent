#!/usr/bin/env bash
# Resumes Dami after tools/dami-down: starts every dami-* container, waits until each
# sidecar answers, then starts the runtime services and the LLM guard timer.
#
# Waiting is the point. dami-host and dami-proactive resolve their sidecars on the first
# turn, and a host started against a still-loading Ollama or a red Elasticsearch spends
# its first minutes logging failures. Each check is the sidecar's own readiness endpoint,
# capped at three minutes; a sidecar that never answers is reported and the services are
# started anyway, so a broken Kibana does not keep Discord down.
#
# Run: tools/dami-up            (no sudo once tools/bootstrap-sudoless-deploy.sh has run)
#      tools/dami-up --dry-run  (print what would run)
# Source of truth: tools/ in the dami-agent repository.
set -euo pipefail

DRY_RUN=no
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=yes

CONTAINERS=(dami-embed dami-rerank dami-llm dami-stt dami-searxng dami-elasticsearch dami-kibana dami-filebeat dami-lan-proxy)
UNITS=(dami-tts.service dami-host.service dami-proactive.service dami-llm-guard.timer)
WAIT_SECONDS="${DAMI_UP_WAIT:-180}"

run() {
    if [[ "$DRY_RUN" == yes ]]; then
        echo "would: $*"
    else
        "$@" >/dev/null
    fi
}

# The address each sidecar answers on once it is actually ready, not merely started.
ready_url() {
    case "$1" in
        dami-embed) echo "http://127.0.0.1:8080/health" ;;
        dami-rerank) echo "http://127.0.0.1:8081/health" ;;
        dami-llm) echo "http://127.0.0.1:11434/api/version" ;;
        dami-stt) echo "http://127.0.0.1:8090/health" ;;
        dami-searxng) echo "http://127.0.0.1:8888/healthz" ;;
        dami-elasticsearch) echo "http://127.0.0.1:9200/_cluster/health?wait_for_status=yellow&timeout=5s" ;;
        dami-kibana) echo "http://127.0.0.1:5601/api/status" ;;
        dami-lan-proxy) echo "https://127.0.0.1:8443/lan-proxy/health" ;;
        *) echo "" ;;
    esac
}

wait_ready() {
    local container="$1" url deadline
    url=$(ready_url "$container")
    [[ -z "$url" ]] && return 0
    [[ "$DRY_RUN" == yes ]] && { echo "would: wait for $url"; return 0; }
    deadline=$((SECONDS + WAIT_SECONDS))
    until curl -skf -m 5 "$url" >/dev/null 2>&1; do
        if (( SECONDS >= deadline )); then
            echo "WARNING: $container did not answer at $url within ${WAIT_SECONDS}s; continuing" >&2
            return 0
        fi
        sleep 2
    done
    echo "ready $container"
}

echo "== starting containers"
for container in "${CONTAINERS[@]}"; do
    state=$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null || echo missing)
    case "$state" in
        running) echo "already running $container" ;;
        missing) echo "skip $container (no such container)"; continue ;;
        *) run docker start "$container"; echo "started $container" ;;
    esac
    wait_ready "$container"
done

echo "== starting services"
for unit in "${UNITS[@]}"; do
    if systemctl list-unit-files "$unit" --no-legend 2>/dev/null | grep -q "$unit"; then
        run systemctl --no-ask-password start "$unit"
        echo "started $unit"
    else
        echo "skip $unit (not installed)"
    fi
done

if command -v dami >/dev/null 2>&1 && [[ "$DRY_RUN" == no ]]; then
    echo "== dami health"
    dami health || echo "WARNING: dami health reported a failure; see above" >&2
fi
echo "== resumed."
