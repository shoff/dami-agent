#!/usr/bin/env bash
# Restarts the Ollama sidecar when a loaded model is not fully in VRAM.
#
# Fifth occurrence of the failure this exists for: after heavy TEI VRAM use, Ollama
# loads the next model on CPU and stays there - answering at 2 tok/s instead of 90+.
# A healthy endpoint says nothing about the device (runbook 4.3).
#
# 2026-09-05: it fired at 13:24:44, under a live Discord turn, on qwen3 that was merely
# *loading* after the vision model had evicted it - and killed the turn. A model in the
# middle of loading also reports size_vram < size. So the condition has to hold twice,
# thirty seconds apart, before anything is restarted; a load finishes in seconds, a CPU
# fallback does not.
#
# 2026-09-29: dami-llm, dami-embed and dami-rerank were stopped by hand on 2026-09-27 to
# lend the card to another job and never started again. dami-host kept running and failed
# every turn for forty hours (990 "Connection refused" in its journal) while this guard
# said nothing, because a stopped sidecar was "not this guard's job". It now says so when
# dami-host is up and a GPU sidecar is not. It does not start them: the card may still be
# lent out, and three models landing on it would take the borrower down. Lending the card
# on purpose is tools/dami-down, which stops dami-host too and so silences this.
# Source of truth: tools/systemd/ in the dami-agent repository.
set -euo pipefail

GPU_SIDECARS=(dami-llm dami-embed dami-rerank)
NOTIFY_USER="${DAMI_GUARD_NOTIFY_USER:-steve}"

# The GPU sidecars that are stopped while dami-host is running, space-separated.
stranded() {
    systemctl is-active --quiet dami-host.service || return 0
    local container stopped=()
    for container in "${GPU_SIDECARS[@]}"; do
        if [ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null)" != "true" ]; then
            stopped+=("$container")
        fi
    done
    echo "${stopped[*]}"
}

# Best effort: a desktop notification in the notify user's session. The journal line and
# the failed unit are the record; this is the part a person sees.
notify() {
    local uid
    uid=$(id -u "$NOTIFY_USER" 2>/dev/null) || return 0
    [ -S "/run/user/$uid/bus" ] || return 0
    runuser -u "$NOTIFY_USER" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        notify-send --urgency=critical --app-name=Dami "$1" "$2" 2>/dev/null || true
}

degraded() {
    local placement
    placement=$(curl -sf -m 10 http://127.0.0.1:11434/api/ps) || { echo no; return; }   # idle/down: not this guard's job
    printf '%s' "$placement" | python3 -c '
import json, sys
models = json.load(sys.stdin).get("models", [])
print("yes" if any(m.get("size_vram", 0) < m.get("size", 1) for m in models) else "no")
'
}

status=0
down=$(stranded)
if [ -n "$down" ]; then
    echo "dami-llm-guard: dami-host is running but $down stopped; every turn will fail. Start them: docker start $down (or tools/dami-up)" >&2
    notify "Dami cannot think" "dami-host is up but $down stopped. Run Resume Dami, or docker start $down. If you are borrowing the GPU, use Pause Dami instead."
    status=1
fi

if [ "$(degraded)" != "yes" ]; then
    exit "$status"
fi

sleep 30
if [ "$(degraded)" = "yes" ]; then
    echo "dami-llm-guard: model not fully in VRAM for 30s; restarting dami-llm"
    docker restart dami-llm
else
    echo "dami-llm-guard: model was loading, now in VRAM; leaving it alone"
fi
exit "$status"
