# Dami Core - proactive tier host. NOT installed automatically.
#
# To deploy:
#   dotnet publish Dami/src/Dami.Host.Proactive -c Release -o /opt/dami/proactive
#   sudo cp tools/systemd/dami-proactive.service /etc/systemd/system/
#   sudo systemctl edit dami-proactive     # add the Environment= lines below with real values
#   sudo systemctl enable --now dami-proactive
#
# Configuration comes from the environment, never a file in the repository:
#   Environment=ConnectionStrings__Dami=Host=127.0.0.1;Port=5432;Database=dami-data;Username=dami_app;Passfile=/home/steve/.pgpass
#   Environment=Egress__AllowedHosts__0=hnrss.org
#   Environment=InterestScout__Feeds__0=https://hnrss.org/frontpage
#   Environment=InterestScout__Interests__0=...

[Unit]
Description=Dami Core proactive tier
# time-sync.target is load-bearing, not decoration. This host keeps the RTC flagged
# local-time while the RTC actually holds UTC, so the kernel sets the clock ~5 h ahead
# at boot and timesyncd yanks it back ~30 s later. The tier used to start inside that
# window and run its first RunDueAsync against a clock 5 h in the future, which makes a
# nightly pass look due early and writes future ranAt/lease timestamps into the durable
# run log — poisoning due-ness until the real time catches up. Ordering after a synced
# clock closes the window. Requires systemd-time-wait-sync.service to be enabled;
# without it time-sync.target never activates and this ordering is a no-op.
After=time-sync.target network-online.target postgresql.service
Wants=time-sync.target network-online.target

[Service]
Type=exec
User=steve
# WorkingDirectory is load-bearing: without it the content root is / and
# appsettings.json silently does not load.
WorkingDirectory=/opt/dami/proactive
ExecStart=/opt/dami/proactive/Dami.Host.Proactive
Restart=on-failure
RestartSec=30

# The tier is throughput-tolerant by definition; never compete with the interactive tier.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
