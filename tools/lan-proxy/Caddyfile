# The LAN door to Dami's web view. One credential, TLS from Caddy's own local CA, the
# runtime untouched on loopback. LAN_PROXY_USER, LAN_PROXY_HASH and LAN_PROXY_ADDRESS
# come from ~/.config/dami/lan-proxy.env (written by set-password.sh, never committed).
# A site needs names for the internal CA to issue a certificate: the LAN address, and
# loopback for checks from this host.
{
	admin off
	auto_https disable_redirects
}

https://{$LAN_PROXY_ADDRESS}:8443, https://127.0.0.1:8443, https://localhost:8443 {
	tls internal

	# Unauthenticated liveness for the container healthcheck; reveals nothing.
	handle /lan-proxy/health {
		respond "ok" 200
	}

	handle {
		basic_auth {
			{$LAN_PROXY_USER} {$LAN_PROXY_HASH}
		}

		# flush_interval -1 lets /turns/stream reach the browser token by token.
		reverse_proxy 127.0.0.1:5810 {
			flush_interval -1
		}
	}
}
