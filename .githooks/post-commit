#!/usr/bin/env bash
# Enabled by:  git config core.hooksPath .githooks
#
# Two jobs, both non-negotiable in a repository shared by two agents and Steve:
#
# 1. Ownership. Agents sometimes run as root while the repository belongs to steve.
#    Without the repair, every root-made commit leaves root-owned blobs in .git/objects
#    and root-owned files in the tree, and the next `git add` by anyone else fails with
#    "insufficient permission for adding an object to repository database".
#
# 2. The board. When a commit touches TODO.md, the task board is re-imported at HEAD
#    (O2b) so the board never trails the file. The import advances only and reports
#    conflicts; it cannot regress state written on the board, and it cannot fail the
#    commit.
set -uo pipefail
repo="$(git rev-parse --show-toplevel)"

if [ "$(id -u)" -eq 0 ]; then
    owner="$(stat -c '%U:%G' "$repo")"
    [ "$owner" = "root:root" ] || chown -R "$owner" "$repo"
fi

if git diff-tree --no-commit-id --name-only -r HEAD | grep -qx 'TODO.md'; then
    "$repo/tools/board/sync-from-todo.sh" || true
fi
exit 0
